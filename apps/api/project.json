{
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "emulator": {
      "executor": "nx:run-commands",
      "options": { "command": "docker compose up -d --wait" }
    },
    "serve": {
      "continuous": true,
      "dependsOn": ["emulator"],
      "executor": "nx:run-commands",
      "options": { "command": "cargo run --manifest-path apps/api/Cargo.toml" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --locked --manifest-path apps/api/Cargo.toml --all-targets"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --locked --manifest-path apps/api/Cargo.toml --all-targets -- -D warnings"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo test --locked --manifest-path apps/api/Cargo.toml" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/target/lambda/api"],
      "options": {
        "command": "cargo lambda build --locked --release --arm64 --manifest-path apps/api/Cargo.toml"
      }
    }
  }
}
